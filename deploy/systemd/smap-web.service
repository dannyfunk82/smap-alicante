[Unit]
Description=SMAP Web
After=network.target postgresql.service

[Service]
Type=simple
User=smap
Group=smap
WorkingDirectory=/opt/smap-web
EnvironmentFile=/opt/smap-web/.env.production.local
ExecStartPre=/usr/bin/node --env-file=/opt/smap-web/.env.production.local /opt/smap-web/scripts/preflight.mjs
ExecStart=/usr/bin/node --env-file=/opt/smap-web/.env.production.local /opt/smap-web/scripts/production-start.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/smap-web/.next /opt/smap-web/backups

[Install]
WantedBy=multi-user.target
