{
  "name": "smap-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "validate": "node scripts/validate.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm run test:unit",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "gtfs:import": "node scripts/import-gtfs.mjs",
    "telemetry:simulate": "node scripts/simulate-external-telemetry.mjs",
    "preflight": "node scripts/preflight.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "release": "node scripts/release.mjs",
    "start:production": "node scripts/production-start.mjs",
    "retention": "node scripts/retention.mjs",
    "release:status": "node scripts/release-status.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "continuity:report": "node scripts/continuity-report.mjs",
    "acceptance": "node --env-file=.env.local scripts/acceptance-check.mjs",
    "handover:report": "node --env-file=.env.local scripts/handover-report.mjs",
    "test:windows-pack": "node --test tests/windows-pack.test.mjs",
    "integrity": "node --env-file=.env.local scripts/data-integrity.mjs",
    "integrity:report": "node --env-file=.env.local scripts/data-integrity.mjs --no-fail",
    "maintenance:report": "node --env-file=.env.local scripts/maintenance-report.mjs",
    "test:maintenance-pack": "node --test tests/maintenance-pack.test.mjs",
    "alicante:download": "node --env-file=.env.local scripts/download-alicante-gtfs.mjs",
    "alicante:import": "node --env-file=.env.local scripts/import-alicante-gtfs.mjs",
    "alicante:status": "node --env-file=.env.local scripts/alicante-gtfs-status.mjs",
    "test:alicante-data": "node --test tests/alicante-real-data.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "jose": "^6.0.0",
    "next": "^16.0.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "@types/qrcode": "^1.5.5"
  },
  "engines": {
    "node": ">=22"
  }
}
